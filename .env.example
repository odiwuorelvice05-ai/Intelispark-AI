# Required
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Language model: any OpenAI-compatible chat-completions API with tool calling.
# LLM_API_KEY is required for the assistant to answer. (MISTRAL_API_KEY is still accepted as a fallback name.)
LLM_API_KEY=
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_MODEL=mistral-small-latest

# Optional tuning
# ASSISTANT_DEADLINE_S=7          # whole-turn time budget in seconds; keep below your Vercel function timeout
# ASSISTANT_HISTORY_MESSAGES=10   # prior messages shown to the model
APP_NAME=Intelispark AI
ENVIRONMENT=development
