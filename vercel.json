{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/style.css",
      "destination": "/frontend/style.css"
    },
    {
      "source": "/script.js",
      "destination": "/frontend/script.js"
    },
    {
      "source": "/onboarding.js",
      "destination": "/frontend/onboarding.js"
    },
    {
      "source": "/design-enhancements.css",
      "destination": "/frontend/design-enhancements.css"
    }
  ]
}
